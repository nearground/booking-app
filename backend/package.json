{
    "name": "pv-today-api",
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "start": "cross-env NODE_ENV=production node ./server/bin/www",
        "start:dev": "cross-env NODE_ENV=development nodemon ./server/bin/www",
        "format:check": "prettier --check .",
        "format:write": "prettier --write .",
        "lint:check": "eslint .",
        "lint:fix": "eslint --fix .",
        "code-fix": "lint-staged",
        "schedule:sync": "node ./server/scripts/sync-schedules.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:ci": "jest --ci --runInBand --coverage"
    },
    "dependencies": {
        "@faker-js/faker": "9.9.0",
        "bcrypt": "^6.0.0",
        "cookie-parser": "~1.4.4",
        "cors": "^2.8.5",
        "cron-parser": "^5.5.0",
        "cross-env": "^7.0.3",
        "debug": "~2.6.9",
        "dotenv": "^16.4.1",
        "express": "^4.22.1",
        "helmet": "^8.1.0",
        "http-errors": "~1.6.3",
        "ioredis": "^5.3.3",
        "jade": "^0.29.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.1",
        "mysql2": "^3.8.0",
        "node-cron": "^4.2.1",
        "nodemailer": "^8.0.4",
        "npm-run-all": "^4.1.5",
        "rate-limiter-flexible": "^2.4.0",
        "sequelize": "^6.35.2"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "prettier --write",
            "eslint --fix",
            "git add"
        ]
    },
    "devDependencies": {
        "@babel/core": "^7.29.0",
        "@babel/preset-env": "^7.29.2",
        "babel-jest": "^29.7.0",
        "babel-plugin-transform-import-meta": "^2.3.3",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-react": "^7.33.2",
        "husky": "^8.0.3",
        "jest": "^29.7.0",
        "lint-staged": "^15.2.2",
        "nodemon": "^3.0.3",
        "prettier": "^3.2.5",
        "sequelize-cli": "^6.6.5",
        "supertest": "^7.2.2"
    }
}
