# Development Environment
DEV_DB_HOST=localhost
DEV_DB_USER=your_username
DEV_DB_PASS=your_password
DEV_DB_NAME=staybooker_test

# Production Environment
PROD_DB_HOST=localhost
PROD_DB_USER=your_username
PROD_DB_PASS=your_password
PROD_DB_NAME=staybooker_prod

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Public media base URL for R2 object reads
MEDIA_PUBLIC_BASE_URL=http://localhost:4000/api/media/object

# Backend-mediated upload to local R2 worker
R2_WORKER_BASE_URL=http://127.0.0.1:8787
R2_DEV_TOKEN=change-me-local-r2-token