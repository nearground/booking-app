# MySQL Configuration
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=staybooker
MYSQL_USER=staybooker
MYSQL_PASSWORD=

# JWT Configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Public media base URL for R2 object reads
MEDIA_PUBLIC_BASE_URL=/api/media/object

# Shared token for local Wrangler R2 write/delete authorization
R2_DEV_TOKEN=change-me-local-r2-token

# Backend -> local Wrangler R2 worker endpoint (Docker Compose dev)
R2_WORKER_BASE_URL=http://r2-local:8787

# Optional outside Docker: absolute path to frontend/public for showcase seed uploads.
# Docker development sets this to its read-only /demo-assets mount automatically.
# SHOWCASE_MEDIA_ASSETS_DIR=/absolute/path/to/frontend/public

# CORS allowlist for backend (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# Auth cookie controls
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
TRUST_PROXY=true
JSON_BODY_LIMIT=2mb
URLENCODED_BODY_LIMIT=2mb

# Startup initialization controls
DB_SYNC_ON_STARTUP=true
DB_SYNC_FORCE=false
SCHEDULER_SYNC_ENABLED=true
SCHEDULER_SYNC_CRON=* * * * *

# App URL for emailed invite, verification and reset links (no browser hostname available)
FRONTEND_BASE_URL=http://localhost:8080

# Notification provider: smtp | console | disabled (console logs only; no email is sent)
NOTIFICATIONS_PROVIDER=console

# Sender identity required for SMTP
NOTIFICATIONS_FROM_EMAIL=no-reply@example.com

# Optional API key for future Resend provider
RESEND_API_KEY=

# Invite creation rate limiting (per authenticated user + organization)
ORGANIZER_INVITE_RATE_LIMIT_MAX=20
ORGANIZER_INVITE_RATE_LIMIT_WINDOW_MS=900000

# Auth and onboarding abuse controls
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_REGISTER_RATE_LIMIT_MAX=10
AUTH_REGISTER_RATE_LIMIT_WINDOW_MS=3600000
AUTH_FORGOT_RATE_LIMIT_MAX=8
AUTH_FORGOT_RATE_LIMIT_WINDOW_MS=3600000
ORGANIZER_ONBOARDING_RATE_LIMIT_MAX=8
ORGANIZER_ONBOARDING_RATE_LIMIT_WINDOW_MS=3600000

# Spacemail / SMTP configuration (for NOTIFICATIONS_PROVIDER=smtp)
SPACEMAIL_HOST=
SPACEMAIL_PORT=587
SPACEMAIL_SECURE=false
SPACEMAIL_USER=
# Single quotes preserve literal $ characters in Docker Compose credentials.
# After changing mail settings, run: docker compose up -d --no-deps backend
SPACEMAIL_PASS=''
