# MySQL Configuration
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=staybooker
MYSQL_USER=staybooker
MYSQL_PASSWORD=
MYSQL_HOST=database
# JWT Configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Local R2 worker integration
R2_DEV_TOKEN=change-me-local-r2-token
R2_WORKER_BASE_URL=http://r2-local:8787


SCHEDULER_SYNC_ENABLED=true
SCHEDULER_SYNC_INTERVAL=60000
SCHEDULER_SYNC_CRON=0 3 * * 0  # Every Sunday at 3am



# Spacemail / SMTP configuration (for NOTIFICATIONS_PROVIDER=smtp)
SPACEMAIL_HOST=
SPACEMAIL_PORT=587
SPACEMAIL_SECURE=false
SPACEMAIL_USER=
SPACEMAIL_PASS=

# Redis URL for local docker-compose redis service
# Format: redis://<host>:<port>
REDIS_URL=redis://redis:6379

FRONTEND_BASE_URL=https://puertovallarta.today
MEDIA_PUBLIC_BASE_URL=/api/media/object
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=https://puertovallarta.today
PROD_DB_NAME =staybooker
