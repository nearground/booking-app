# Development Dockerfile for hot reload
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install


# Expose port for React dev server
EXPOSE 3000

# Set environment variable to enable polling for file changes (needed for Docker)
ENV CHOKIDAR_USEPOLLING=true

# Start the Vite development server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
