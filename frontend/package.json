{
  "name": "pv-today",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.5.2",
    "@fortawesome/free-regular-svg-icons": "^6.5.2",
    "@fortawesome/free-solid-svg-icons": "^6.5.2",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@testing-library/user-event": "^14.5.2",
    "date-fns": "^3.6.0",
    "formik": "^2.4.5",
    "husky": "^8.0.3",
    "leaflet": "^1.9.4",
    "lodash": "^4.17.21",
    "query-string": "^9.0.0",
    "react": "^18.3.1",
    "react-date-range": "^2.0.0-alpha.4",
    "react-dom": "^18.3.1",
    "react-image-gallery": "^1.3.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.23.1",
    "react-select": "^5.8.0",
    "react-to-print": "^2.15.1",
    "sass": "^1.75.0",
    "web-vitals": "^4.0.1",
    "yup": "^1.4.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npx cypress run --e2e && npx cypress run --component",
    "format:check": "prettier --check 'src/**/*.{js,jsx,ts,tsx,json,css,md}'",
    "lint:check": "eslint src cypress",
    "lint-fix": "lint-staged",
    "prepare": "husky install",
    "cypress:open": "cypress open",
    "cypress:run": "npx cypress run --e2e && npx cypress run --component",
    "cypress:e2e": "cypress run --e2e",
    "cypress:e2e:open": "cypress open --e2e",
    "cypress:e2e:booking": "cypress run --e2e --spec 'cypress/e2e/booking/**'",
    "test:unit": "vitest",
    "test:unit:ci": "vitest --run --coverage"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write 'src/**/*.{js,jsx,ts,tsx,json,css,md}'",
      "eslint --fix .",
      "git add"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.21",
    "cypress": "^13.10.0",
    "eslint": "^8.57.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-cypress": "^2.15.1",
    "jsdom": "^24.1.3",
    "lint-staged": "^15.2.2",
    "msw": "^2.13.2",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.3",
    "vite": "^5.4.19",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9",
    "wait-on": "^7.2.0"
  }
}
